{
	"name": "pmmusic",
	"displayName": "PMMusic",
	"description": "Write and play music projects for the Pokemon mini.",
	"license": "MIT",
	"publisher": "LogicPlace",
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.99.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/logicplace/vscode-pmmusic.git"
	},
	"bugs": {
		"url": "https://github.com/logicplace/vscode-pmmusic/issues"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"pokemon mini",
		"highlighter",
		"syntax"
	],
	"galleryBanner": {
		"color": "#6600ff",
		"theme": "dark"
	},
	"activationEvents": [
		"onLanguage:pmmusic"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "pmmusic",
				"aliases": [
					"PM Music",
					"pmmusic"
				],
				"extensions": [
					".pmmusic"
				]
			}
		],
		"grammars": [
			{
				"language": "pmmusic",
				"scopeName": "source.pmmusic",
				"path": "./grammars/pmmusic.tmLanguage"
			}
		],
		"configuration": {
			"properties": {
				"pmmusic.enableCodeLens": {
					"type": "boolean",
					"default": true
				},
				"pmmusic.soundEngine": {
					"type": "string",
					"default": "direct",
					"anyOf": [
						"direct",
						"emulated",
						"direct_pwm"
					]
				},
				"pmmusic.filter": {
					"type": "string",
					"default": "piezo",
					"anyOf": [
						"disabled",
						"piezo"
					]
				}
			}
		},
		"commands": [
			{
				"command": "pmmusic.compilePMAS",
				"title": "Compile .pmmusic to PMAS syntax"
			}
		]
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.18",
		"@types/vscode": "^1.99.1",
		"esbuild": "^0.25.4",
		"eslint": "^9.25.0",
		"glob": "^11.0.1",
		"globals": "^16.0.0",
		"mocha": "^11.1.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.30.1",
		"vscode-test": "^1.6.1"
	},
	"dependencies": {
		"@browserbox/speaker": "^1.0.1",
		"pmsound": "github:logicplace/pm-sound-js"
	}
}
